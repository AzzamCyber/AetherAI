{
  "buildCommand": "mkdir -p public && cp index.html install.ps1 install.sh aetherai.cjs public/ || true",
  "outputDirectory": "public",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/install.ps1",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/html.*"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/install.sh",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/html.*"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
